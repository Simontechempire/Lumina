# ======================
# LUMINA BOT - ENVIRONMENT VARIABLES
# Replace the values below with your real ones
# ======================

# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Your Telegram User ID (Owner) - only this ID can control the bot
OWNER_TELEGRAM_ID=your_telegram_user_id_here

# Optional: Port (Render sets this automatically)
PORT=10000
